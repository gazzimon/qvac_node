{
  "name": "qvac-node",
  "version": "0.1.0",
  "description": "Nodo de inferencia QVAC distribuido por Pear. Se instala por P2P y se actualiza solo por OTA.",
  "private": true,
  "bin": "bin.mjs",
  "upgrade": "pear://8f789f6hsf4ghymku5eqwqmbqiubiigp8xpy6boiymunnbyznpny",
  "pear": {
    "name": "qvac-node",
    "stage": {
      "ignore": [
        "/.git",
        "/.github",
        "/.gitignore",
        "/.gitattributes",
        "/.prettierrc",
        "/old",
        "/out",
        "/test",
        "/scripts",
        "/NOTES.md",
        "/PROMPT_CLAUDE_CODE_QVAC-NODE_PEARS_FASE0-1.md",
        "/PROMPT_VAULT-GUARDIAN.md",
        "/qvac-node-runbook_pears.html",
        "/node_modules/@jridgewell",
        "/node_modules/@types",
        "/node_modules/bare-apk",
        "/node_modules/bare-build",
        "/node_modules/bare-build-android-arm",
        "/node_modules/bare-build-android-arm64",
        "/node_modules/bare-build-android-ia32",
        "/node_modules/bare-build-android-x64",
        "/node_modules/bare-build-darwin-arm64",
        "/node_modules/bare-build-darwin-x64",
        "/node_modules/bare-build-ios-arm64",
        "/node_modules/bare-build-ios-arm64-simulator",
        "/node_modules/bare-build-ios-x64-simulator",
        "/node_modules/bare-build-linux-arm64",
        "/node_modules/bare-build-linux-x64",
        "/node_modules/bare-build-win32-arm64",
        "/node_modules/bare-build-win32-x64",
        "/node_modules/bare-bundle-id",
        "/node_modules/bare-cov",
        "/node_modules/bare-crypto",
        "/node_modules/bare-debug-log",
        "/node_modules/bare-encoding",
        "/node_modules/bare-format",
        "/node_modules/bare-http-parser",
        "/node_modules/bare-http1",
        "/node_modules/bare-https",
        "/node_modules/bare-inspector",
        "/node_modules/bare-lief",
        "/node_modules/bare-link",
        "/node_modules/bare-net",
        "/node_modules/bare-pack",
        "/node_modules/bare-runtime",
        "/node_modules/bare-runtime-win32-x64",
        "/node_modules/bare-stylize",
        "/node_modules/bare-subprocess",
        "/node_modules/bare-tls",
        "/node_modules/bare-tpl",
        "/node_modules/bare-unpack",
        "/node_modules/bare-utils",
        "/node_modules/bare-v8-to-istanbul",
        "/node_modules/bare-ws",
        "/node_modules/brittle",
        "/node_modules/convert-source-map",
        "/node_modules/error-stack-parser",
        "/node_modules/globbie",
        "/node_modules/lunte",
        "/node_modules/picomatch",
        "/node_modules/prettier",
        "/node_modules/prettier-config-holepunch",
        "/node_modules/promaphore",
        "/node_modules/same-object",
        "/node_modules/stackframe",
        "/node_modules/test-tmp",
        "/node_modules/tmatch",
        "/node_modules/v8-to-istanbul",
        "/node_modules/rocksdb-native/prebuilds/android-arm",
        "/node_modules/rocksdb-native/prebuilds/android-arm64",
        "/node_modules/rocksdb-native/prebuilds/android-ia32",
        "/node_modules/rocksdb-native/prebuilds/android-x64",
        "/node_modules/rocksdb-native/prebuilds/ios-arm64",
        "/node_modules/rocksdb-native/prebuilds/ios-arm64-simulator",
        "/node_modules/rocksdb-native/prebuilds/ios-x64-simulator"
      ]
    }
  },
  "scripts": {
    "start": "bare bin.mjs --no-updates",
    "format": "prettier . --write",
    "lint": "prettier . --check && lunte",
    "test": "brittle-bare test/index.js",
    "make": "node scripts/make.js",
    "make:darwin-arm64": "bare-build --name qvac-node --standalone --host darwin-arm64 --out ./out/darwin-arm64 bin.mjs",
    "make:darwin-x64": "bare-build --name qvac-node --standalone --host darwin-x64 --out ./out/darwin-x64 bin.mjs",
    "make:linux-arm64": "bare-build --name qvac-node --standalone --host linux-arm64 --out ./out/linux-arm64 bin.mjs",
    "make:linux-x64": "bare-build --name qvac-node --standalone --host linux-x64 --out ./out/linux-x64 bin.mjs",
    "make:win32-arm64": "bare-build --name qvac-node --standalone --host win32-arm64 --out ./out/win32-arm64 bin.mjs",
    "make:win32-x64": "bare-build --name qvac-node --standalone --host win32-x64 --out ./out/win32-x64 bin.mjs"
  },
  "dependencies": {
    "bare-os": "^3.9.3",
    "bare-path": "^3.1.1",
    "bare-process": "^4.5.1",
    "bare-storage": "^1.1.0",
    "corestore": "^7.9.2",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hello-pear-worker": "^1.1.0",
    "hyperswarm": "^4.17.0",
    "paparam": "^1.13.0",
    "pear-runtime": "^1.3.1",
    "ready-resource": "^1.2.0",
    "which-runtime": "^1.4.0"
  },
  "devDependencies": {
    "bare-build": "^1.0.2",
    "bare-runtime": "^1.31.0",
    "brittle": "^3.19.0",
    "lunte": "^1.2.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gazzimon/qvac_node.git"
  },
  "author": "gazzimon",
  "license": "Apache-2.0"
}
